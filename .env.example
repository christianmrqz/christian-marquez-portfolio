# Copia este archivo como .env.local. Nada es obligatorio: sin variables, todo funciona en modo local y simulado.
# Nunca subas claves al repositorio (.env* está en .gitignore salvo este ejemplo).

# URL pública del portfolio (Open Graph, sitemap, robots y JSON-LD).
# En Vercel no hace falta: se usa VERCEL_PROJECT_PRODUCTION_URL. Defínela si usas un dominio propio.
# NEXT_PUBLIC_SITE_URL=https://tu-dominio.es

# Código de verificación de Google Search Console (meta google-site-verification).
# GOOGLE_SITE_VERIFICATION=

# Servicio Python de la demo ERP. En local, npm run dev la fija sola (http://127.0.0.1:8001).
# En Vercel no hace falta: /api/erp lo sirve api/erp.py. En otro alojamiento, apunta al servicio desplegado.
# Se lee al hacer el build (reescritura de Next.js).
# ERP_SERVICE_URL=http://127.0.0.1:8001

# --- Variables del servicio Python (se leen en el proceso de Python / función de Vercel) ---

# Extractor: rules (por defecto, simulación determinista) | openai
# ERP_EXTRACTOR=openai
# OPENAI_API_KEY=
# Modelo con soporte de salida JSON estricta (response_format json_schema). Elige uno vigente en tu cuenta.
# OPENAI_MODEL=

# ERP: sandbox (por defecto, pedidos ficticios) | odoo
# ERP_GATEWAY=odoo
# ODOO_URL=https://tu-instancia.odoo.com
# ODOO_DB=
# ODOO_LOGIN=
# ODOO_API_KEY=
# Solo con true el adaptador escribe en Odoo. No lo actives en una demo pública.
# ODOO_ALLOW_WRITE=false

# Registro de peticiones del servidor Python local (1 para activarlo).
# ERP_LOG=0
